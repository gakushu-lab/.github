{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "budgets.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": { "aws:SourceArn": "arn:aws:budgets::831963379503:budget/*" },
        "StringEquals": { "aws:SourceAccount": "831963379503" }
      }
    }
  ]
}
