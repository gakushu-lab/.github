{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FreezeMemberOperations",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_LabDeveloper_*",
            "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_LabDeveloper_*",
            "arn:aws:iam::*:role/LabGitHubDeploy"
          ]
        }
      }
    }
  ]
}
