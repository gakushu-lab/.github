{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIam",
      "Effect": "Allow",
      "Action": ["iam:Get*", "iam:List*"],
      "Resource": "*"
    },
    {
      "Sid": "PassLabLambdaExec",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/LabLambdaExec",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "PassLabSchedulerExec",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/LabSchedulerExec",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "scheduler.amazonaws.com" }
      }
    },
    {
      "Sid": "PassLabStatesExec",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/LabStatesExec",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "states.amazonaws.com" }
      }
    },
    {
      "Sid": "PassLabEventsExec",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/LabEventsExec",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "events.amazonaws.com" }
      }
    }
  ]
}
